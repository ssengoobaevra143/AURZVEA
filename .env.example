# Use your Neon PostgreSQL pooled connection string in Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Set to disable only for a trusted local database without TLS.
DATABASE_SSL=require
# Generate a long random secret; send it as the x-admin-token header to /api/admin/review.
AUREVE_ADMIN_TOKEN=replace-with-a-long-random-secret
